# Pull in the Armv8-M (Cortex-M33 / STAR-MC1) common support.

include armv8-m/Make.defs

# BK7258 chip-specific sources.

CHIP_CSRCS += bk7258_start.c bk7258_irq.c bk7258_lowputc.c
CHIP_CSRCS += bk7258_allocateheap.c bk7258_gpio.c bk7258_clockconfig.c
CHIP_CSRCS += bk7258_timerisr.c
CHIP_CSRCS += bk7258_idle.c
CHIP_CSRCS += bk7258_wdt.c
ifeq ($(CONFIG_BK7258_RTC),y)
CHIP_CSRCS += bk7258_rtc.c
endif
ifeq ($(CONFIG_BK7258_WDT),y)
CHIP_CSRCS += bk7258_wdt_lowerhalf.c
endif
ifeq ($(CONFIG_BK7258_I2C1),y)
CHIP_CSRCS += bk7258_i2c.c
endif
ifeq ($(CONFIG_BK7258_SPI1),y)
CHIP_CSRCS += bk7258_spi.c
CHIP_CSRCS += bk7258_qspi.c
endif

ifeq ($(CONFIG_BK7258_UART0),y)
CHIP_CSRCS += bk7258_serial.c
else ifeq ($(CONFIG_BK7258_UART1),y)
CHIP_CSRCS += bk7258_serial.c
else ifeq ($(CONFIG_BK7258_UART2),y)
CHIP_CSRCS += bk7258_serial.c
endif
