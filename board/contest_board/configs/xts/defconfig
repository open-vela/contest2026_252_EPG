CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="bk7258"
CONFIG_ARCH_IDLE_CUSTOM=y
CONFIG_ARCH_INTERRUPTSTACK=8192
CONFIG_ARCH_IRQPRIO=y
CONFIG_ARCH_MINIMAL_VECTORTABLE=y
CONFIG_ARCH_MINIMAL_VECTORTABLE_DYNAMIC=y
CONFIG_ARCH_NUSER_INTERRUPTS=24
CONFIG_ARCH_STACKDUMP=y
CONFIG_BK7258_EARLY_MARKERS=y
# CONFIG_BK7258_LED_PROBE is not set
# CONFIG_BK7258_TXPIN_PROBE is not set
# CONFIG_BK7258_TXPIN_PROBE_LATE is not set
# CONFIG_BK7258_TXPIN_TRACE is not set
# CONFIG_BK7258_UART_DUMP is not set
