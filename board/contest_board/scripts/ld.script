/****************************************************************************
 * board/contest_board/scripts/ld.script
 *
 * Link script for the Agora ConvoAI Kit R1 (Beken BK7258), CPU0.
 *
 * Flash layout
 * ------------
 * The BK7258 flash controller checks a CRC while fetching, and stores two
 * CRC bytes after every 32 bytes of payload.  Addresses therefore come in
 * two flavours:
 *
 *   physical - the byte offset actually programmed into the flash part
 *   virtual  - the address the CPU sees through the XIP window, which is
 *              physical * 32/34
 *
 * From the Beken partition table (middleware/boards/bk7258/partitions.csv)
 * the bootloader occupies the first 68 KB of flash, so the application
 * begins at physical 0x11000, which is virtual 0x10000.  Added to the XIP
 * window base of 0x02000000 that puts our reset vector at 0x02010000.
 *
 * The image is allowed to run past the app partition, to 3648 KB (0x390000)
 * of usable virtual space.  That needs saying, because the partition table
 * says 1836 KB physical and this takes nearly all of the 4 MB the table
 * covers.
 *
 * Two facts make it safe, both established rather than assumed.  The boot
 * loader looks the "app" partition up by name, takes its offset, converts
 * it with the same 34:32 ratio, and jumps -- it never reads the size and
 * never checks the image (disassembled; see README chapter 9).  And the
 * partitions this grows over are not in use here: app1 and app2 hold the
 * CPU1 and CPU2 images, which are started by start_cpu1_core() from CPU0
 * application code under CONFIG_CPU_CNT > 1 and never by the boot loader,
 * so a CPU0-only NuttX never starts those cores at all; download is OTA
 * staging, and nothing here does OTA.
 *
 * The ceiling is usr_config at physical 0x3DA000, which stays, as do
 * rf_firmware and net_param above it -- that is the factory RF calibration
 * this board's radio depends on.  So the usable physical run is
 * 0x3DA000 - 0x11000 = 0x3C9000, and 0x3C9000 * 32 / 34 = 0x390000.
 *
 * The table was drawn for a 4 MB part and this board carries an 8 MB one,
 * which is why an application otherwise gets 1728 KB of a chip with 8192.
 * The unallocated top half cannot extend this: the image is loaded as one
 * contiguous run from 0x11000, and the top half is not contiguous with it.
 * It is reachable as data, which is what the MTD in bk7258_flash.c uses.
 *
 * Licensed to the Apache Software Foundation (ASF) under one or more
 * contributor license agreements.  See the NOTICE file distributed with
 * this work for additional information regarding copyright ownership.  The
 * ASF licenses this file to you under the Apache License, Version 2.0 (the
 * "License"); you may not use this file except in compliance with the
 * License.  You may obtain a copy of the License at
 *
 *   http://www.apache.org/licenses/LICENSE-2.0
 *
 * Unless required by applicable law or agreed to in writing, software
 * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
 * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
 * License for the specific language governing permissions and limitations
 * under the License.
 *
 ****************************************************************************/

#include <nuttx/config.h>

MEMORY
{
  flash (rx)  : ORIGIN = 0x02010000, LENGTH = 3648K
  /* SRAM is six banks: SRAM0 0x28000000 (64K), SRAM1 0x28010000 (64K), then
   * 0x28020000, 0x28040000, 0x28060000 and 0x28080000 at 128K each.  All six
   * take a word write and read it back at handover -- a standalone probe
   * checked eleven addresses across the range and every one survived.  Two
   * stronger requirements narrow what is actually usable, and they pull in
   * opposite directions:
   *
   * The initial stack must sit high.  A probe pointed MSP at eight addresses
   * and made each carry a real call frame: 0x28032468, 0x28042468, 0x28062468,
   * 0x28082468 and 0x2803c800 all survived, while 0x28022468 wedged the CPU
   * outright.  Every linked image whose initial SP fell below that line died
   * before executing one reportable instruction.  The boundary lands where the
   * Beken bootloader keeps its own stack, since its vector table starts SP at
   * 0x28030000 -- suggestive, but not established.
   *
   * .data and .bss must sit low.  With them at 0x28020000 the boot reaches
   * every checkpoint in __start(); moving them to 0x28040000, with the stack
   * left at a known-good address, kills it inside bk7258_clockconfig().  Why a
   * bank that holds a stack cannot hold .bss is not explained yet.
   *
   * So both live in SRAM2: .data/.bss from the bottom, and the IDLE thread
   * stack pushed above the boundary by CONFIG_IDLETHREAD_STACKSIZE.  The
   * heap gets what is left, up to the end of this region.
   *
   * The region runs to 0x28050000 (192K), where the second heap region
   * registered by boardinit begins -- the 64K above the old 128K limit was
   * simply unclaimed.  It has to reach that far: the IDLE stack top is
   * _ebss + CONFIG_IDLETHREAD_STACKSIZE, an arithmetic expression the
   * linker never range-checks, so .bss growth walks it silently past
   * LENGTH and up_allocate_heap's (_eram - g_idle_topstack) goes negative.
   * Linking the closed BLE archives added 37K of .bss and did exactly
   * that: the heap size wrapped to ~4G and the boot died before a word of
   * foreign code ran.
   */

  sram  (rwx) : ORIGIN = 0x28020000, LENGTH = 256K

  /* Top of the camera carve (0x28098000+0x5000 is the YUV line buffer);
   * the remaining 12K hosts SRAM-resident hot code (TJpgDec).
   */

  sramhi (rwx) : ORIGIN = 0x2809d000, LENGTH = 12K
}

OUTPUT_ARCH(arm)
EXTERN(_vectors)
ENTRY(_stext)

SECTIONS
{
    /* The build-id note would otherwise be emitted at the start of the image
     * and push the vector table off the flash base.  The bootloader takes the
     * initial stack pointer and reset address from the first eight bytes of
     * the image, so the vectors have to come first.
     */

    /DISCARD/ : {
        *(.note.gnu.build-id)
    }

    .text : {
        _stext = ABSOLUTE(.);

        /* The vector table has to sit at the start of the image and be
         * aligned to a power of two at least as large as the table itself.
         */

        . = ALIGN(512);
        KEEP(*(.vectors))

        . = ALIGN(4);
        EXCLUDE_FILE(*tjpgd*) *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        EXCLUDE_FILE(*tjpgd*) *(.rodata .rodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.got)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)

        KEEP(*(.init))
        KEEP(*(.fini))
        KEEP(*(.eh_frame*))

        _etext = ABSOLUTE(.);
    } > flash

    .ARM.extab : {
        *(.ARM.extab*)
    } > flash

    __exidx_start = ABSOLUTE(.);
    .ARM.exidx : {
        *(.ARM.exidx*)
    } > flash
    __exidx_end = ABSOLUTE(.);

    .tdata : {
        _stdata = ABSOLUTE(.);
        *(.tdata .tdata.* .gnu.linkonce.td.*);
        _etdata = ABSOLUTE(.);
    } > flash

    .tbss : {
        _stbss = ABSOLUTE(.);
        *(.tbss .tbss.* .gnu.linkonce.tb.* .tcommon);
        _etbss = ABSOLUTE(.);
    } > flash

    /* Load address of .data, used by __start() to copy it into SRAM.
     * LOADADDR is the authoritative answer; a location counter read here
     * only happens to agree while nothing sits between this point and
     * .data's load address.
     */

    _eronly = LOADADDR(.data);

    .ram_vectors : {
        *(.ram_vectors)
    } > sram



    .data : {

        _sdata = ABSOLUTE(.);
        *(.data .data.*)

        /* Closed BLE controller/PHY private data: folding it in here puts it
         * inside the [_sdata,_edata) boot copy.  The BK7258 Bluetooth hardware
         * addresses its exchange-memory descriptors relative to ex_mem, and
         * the vendor linker contract requires this section to be 32-byte
         * aligned.
         */

        . = ALIGN(32);
        KEEP(*(.bt_spec_data*))
        *(.dtcm_sec_data*)
        *(.gnu.linkonce.d.*)
        CONSTRUCTORS

        . = ALIGN(4);
        PROVIDE_HIDDEN (__preinit_array_start = .);
        KEEP(*(.preinit_array))
        PROVIDE_HIDDEN (__preinit_array_end = .);

        . = ALIGN(4);
        _sinit = ABSOLUTE(.);
        PROVIDE_HIDDEN (__init_array_start = .);
        KEEP(*(SORT(.init_array.*)))
        KEEP(*(.init_array))
        _einit = ABSOLUTE(.);
        PROVIDE_HIDDEN (__init_array_end = .);

        . = ALIGN(4);
        PROVIDE_HIDDEN (__fini_array_start = .);
        KEEP(*(SORT(.fini_array.*)))
        KEEP(*(.fini_array))
        PROVIDE_HIDDEN (__fini_array_end = .);

        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > sram AT > flash

    /* TJpgDec executes from SRAM: its working set thrashes the small
     * ICache and XIP fetch latency measured 33x slower than the
     * arithmetic allows.  VMA in the sramhi carve keeps the fragile
     * SRAM2 layout untouched; boardinit copies it in at boot.
     */

    .sramfunc : ALIGN(4) {
        _ssramfunc = ABSOLUTE(.);
        *tjpgd*(.text .text.* .rodata .rodata.*)
        . = ALIGN(4);
        _esramfunc = ABSOLUTE(.);
    } > sramhi AT > flash

    _fsramfunc = LOADADDR(.sramfunc);

    /* Both bounds are 8-byte aligned, not 4.
     *
     * _ebss is where the IDLE thread stack starts, so it decides the initial
     * SP in the vector table, and AAPCS wants that 8-byte aligned at every
     * call boundary.  At ALIGN(4) this landed on 0x28021c64 and the initial SP
     * on 0x28022464, four bytes off: the image then died before reaching the
     * first instruction of __start that could report anything.  Forcing the
     * same image to start with SP = 0x2803c800, which is 8-byte aligned, ran
     * the whole of __start.  arm_fpuconfig() turns the FPU on early, and the
     * double-word FP load/stores that follow do require the alignment.
     */

    .bss : {
        . = ALIGN(8);
        _sbss = ABSOLUTE(.);
        *(.bss .bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(8);
        _ebss = ABSOLUTE(.);
    } > sram

    /* The IDLE thread stack and then the heap follow .bss; see
     * bk7258_start.c and bk7258_allocateheap.c.
     */

    . = ALIGN(8);
    PROVIDE(end = .);
    PROVIDE(_end = .);

    /* End of the usable RAM region, for up_allocate_heap().
     *
     * The heap has to stop where this region stops.  Deriving its end from a
     * chip constant instead -- 0x280a0000, the top of all six SRAM banks --
     * handed the allocator 436K running from SRAM2 clear through SRAM5, and
     * kumm_initialize() writes its bookkeeping at both ends of what it is
     * given.  The far end of that range is in banks this board will not boot
     * .bss out of, so the very first thing nx_start() does with our memory
     * reached into memory that does not behave.
     */

    PROVIDE(_eram = ORIGIN(sram) + LENGTH(sram));

    /* The serial black box (bk7258_serial.c) needs 31 words that no part of
     * this image links, heaps or zeroes, so its breadcrumbs survive the
     * watchdog reset __start() prints them after.  It used to name a fixed
     * address chosen to sit above the linked region; raising LENGTH(sram)
     * later swallowed it, and the interrupt handler spent every interrupt
     * writing tag words over live heap -- the inode tree picked one up as a
     * peer pointer and "ls /dev" took a bus fault at 0x3300000c.  Anchoring
     * the reservation to the region instead of to a constant means the next
     * LENGTH change carries it along.  arm_addregion() starts the upper heap
     * at _ebbnote for the same reason.
     */

    PROVIDE(_bbnote  = ORIGIN(sram) + LENGTH(sram));
    PROVIDE(_ebbnote = ORIGIN(sram) + LENGTH(sram) + 128);

    /* up_allocate_heap() hands out (_eram - g_idle_topstack), and that top
     * of stack is _ebss plus a Kconfig constant -- pure arithmetic, which
     * no region check ever sees.  Let .bss grow past the point where the
     * sum clears LENGTH and the subtraction goes negative, wrapping the
     * heap size to ~4G; the board then dies in nx_start() with nothing on
     * the console.  Fail the link instead.
     */

    ASSERT(_ebss + CONFIG_IDLETHREAD_STACKSIZE <= ORIGIN(sram) +
           LENGTH(sram),
           "IDLE stack top is past the end of the sram region: .bss grew, so raise LENGTH(sram) or lower CONFIG_IDLETHREAD_STACKSIZE")

    /* Debug sections */

    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
